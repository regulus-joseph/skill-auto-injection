{
  "id": "skill-ai-inject",
  "name": "Skill AI Inject",
  "description": "Auto-match user delivery task with available skills using embedding similarity",
  "version": "0.4.0",
  "kind": "utility",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "embedding": {
        "type": "object",
        "properties": {
          "baseURL": { "type": "string", "default": "http://localhost:11434" },
          "model": { "type": "string", "default": "bge-m3" },
          "dimensions": { "type": "integer", "default": 1024 }
        }
      },
          "translate": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "provider": {
            "type": "string",
            "enum": ["ollama"],
            "default": "ollama"
          },
          "model": { "type": "string",         "default": "qwen3.5:4b" }
        }
      },
      "matching": {
        "type": "object",
        "properties": {
          "skillMatchThreshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.6
          },
          "maxSkills": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 3
          },
          "minKeywordMatch": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "l2CandidateCount": {
            "type": "integer",
            "minimum": 1,
            "default": 20
          }
        }
      },
      "keyword": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "model": { "type": "string",         "default": "qwen3.5:4b" },
          "baseURL": { "type": "string" }
        }
      }
    }
  },
  "uiHints": {
    "enabled": {
      "label": "Enable Skill AI Inject",
      "help": "Automatically match user input with available skills"
    },
    "matching.skillMatchThreshold": {
      "label": "Skill Match Threshold",
      "help": "Minimum similarity score (0-1) to consider a skill as a match"
    },
    "matching.maxSkills": {
      "label": "Max Skills to Match",
      "help": "Maximum number of skills to include in the prompt"
    }
  }
}
