{
  "id": "skill-ai-inject",
  "name": "Skill Auto-Injection",
  "description": "Auto-match user delivery task with available skills using embedding similarity",
  "version": "0.4.5",
  "kind": "utility",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "embedding": {
        "type": "object",
        "properties": {
          "baseURL": { "type": "string", "default": "http://localhost:11434" },
          "model": { "type": "string", "default": "bge-m3" },
          "dimensions": { "type": "integer", "default": 1024 }
        }
      },
          "translate": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean", "default": false },
              "provider": {
                "type": "string",
                "enum": ["ollama"],
                "default": "ollama"
              },
              "model": { "type": "string",         "default": "qwen2.5:3b" }
            }
          },
      "matching": {
        "type": "object",
        "properties": {
          "skillMatchThreshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.5
          },
          "maxSkills": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 3
          },
          "minKeywordMatch": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "l2CandidateCount": {
            "type": "integer",
            "minimum": 1,
            "default": 20
          }
        }
      },
      "keyword": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "model": { "type": "string",         "default": "qwen3.5:4b" },
          "baseURL": { "type": "string" },
          "translate": { "type": "boolean", "default": false }
        }
      },
      "taskIntent": {
        "type": "object",
        "properties": {
          "patterns": {
            "type": "array",
            "items": { "type": "string" }
          },
          "requireAll": {
            "type": "boolean",
            "default": false,
            "description": "Require all patterns to match (default: any pattern matches)"
          },
          "caseSensitive": {
            "type": "boolean",
            "default": false,
            "description": "Case sensitive pattern matching"
          },
          "minLength": {
            "type": "integer",
            "minimum": 1,
            "default": 5,
            "description": "Minimum prompt length to check patterns"
          }
        }
      }
    }
  },
  "uiHints": {
    "enabled": {
      "label": "Enable Skill Auto-Injection",
      "help": "Automatically match user input with available skills"
    },
    "matching.skillMatchThreshold": {
      "label": "Skill Match Threshold",
      "help": "Minimum similarity score (0-1) to consider a skill as a match"
    },
    "matching.maxSkills": {
      "label": "Max Skills to Match",
      "help": "Maximum number of skills to include in the prompt"
    }
  }
}
